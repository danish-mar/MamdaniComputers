<div x-data="{ 
    product: null,
    loading: true,
    activeImage: 0,
    productId: '<%= productId %>',
    
    async init() {
        try {
            const allProducts = await ProductsFetcher.getProducts();
            this.product = allProducts.find(p => p.id === this.productId);
            if (!this.product) {
                // If not found in primary list, it might be a direct fetch if API supports it
                // For now, if not found, we show an error
                console.error('Product not found in local cache');
            }
        } catch (error) {
            console.error('Error loading product detail:', error);
        } finally {
            this.loading = false;
        }
    }
}" class="pt-32 pb-24 min-h-screen dark:bg-black transition-colors duration-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Loading State -->
        <div x-show="loading" class="py-32 text-center">
            <div class="flex justify-center items-center space-x-3 mb-6">
                <div class="w-3 h-3 bg-apple-blue rounded-full animate-bounce" style="animation-delay: 0s;"></div>
                <div class="w-3 h-3 bg-apple-blue rounded-full animate-bounce" style="animation-delay: 0.2s;"></div>
                <div class="w-3 h-3 bg-apple-blue rounded-full animate-bounce" style="animation-delay: 0.4s;"></div>
            </div>
            <p class="text-gray-400 text-lg font-medium">Loading product details...</p>
        </div>

        <!-- Error State -->
        <div x-show="!loading && !product" class="py-32 text-center">
            <h2 class="text-3xl font-bold text-apple-dark dark:text-white mb-4">Product Not Found</h2>
            <p class="text-gray-500 mb-8">The product you are looking for might have been sold or removed.</p>
            <a href="/products" class="px-8 py-4 bg-apple-blue text-white rounded-full font-bold hover:scale-105 transition-all inline-block">
                Back to Catalog
            </a>
        </div>

        <!-- Product Content -->
        <div x-show="!loading && product" class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24">
            <!-- Left: Square Gallery -->
            <div class="space-y-8">
                <div class="aspect-square bg-white dark:bg-[#1c1c1e] rounded-[2.5rem] overflow-hidden shadow-2xl relative border border-gray-100 dark:border-white/5 group">
                    <!-- Image -->
                    <template x-if="product?.images && product?.images.length > 0">
                        <img :src="product?.images[activeImage]" 
                             :alt="product?.name"
                             class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105">
                    </template>
                    
                    <!-- Icon Fallback -->
                    <template x-if="!product?.images || product?.images.length === 0">
                        <div class="w-full h-full flex items-center justify-center bg-apple-gray dark:bg-white/5">
                            <i :class="{
                                'fas fa-laptop': (product?.category?.name || product?.category || '').toLowerCase().includes('laptop'),
                                'fas fa-desktop': (product?.category?.name || product?.category || '').toLowerCase().includes('desktop'),
                                'fas fa-tv': (product?.category?.name || product?.category || '').toLowerCase().includes('monitor'),
                                'fas fa-print': (product?.category?.name || product?.category || '').toLowerCase().includes('printer'),
                                'fas fa-microchip': true
                            }" class="text-gray-200 dark:text-white/10 text-9xl"></i>
                        </div>
                    </template>

                    <!-- Status Tags -->
                    <div class="absolute top-8 left-8 flex flex-col gap-3">
                        <span class="bg-apple-blue/90 backdrop-blur-md text-white px-5 py-2 rounded-full text-[11px] font-bold uppercase tracking-[0.2em] shadow-xl shadow-apple-blue/20">
                            Available
                        </span>
                        <template x-if="product?.isSold">
                            <span class="bg-red-500/90 backdrop-blur-md text-white px-5 py-2 rounded-full text-[11px] font-bold uppercase tracking-[0.2em] shadow-xl shadow-red-500/20">
                                Sold Out
                            </span>
                        </template>
                    </div>
                </div>
                
                <!-- Thumbnails -->
                <div x-show="product?.images && product?.images.length > 1" class="flex gap-4 overflow-x-auto pb-4 scrollbar-hide">
                    <template x-for="(img, index) in product?.images" :key="index">
                        <button @click="activeImage = index" 
                                :class="activeImage === index ? 'ring-2 ring-apple-blue scale-95 shadow-lg' : 'opacity-40 hover:opacity-100 hover:scale-105'"
                                class="w-24 h-24 shrink-0 bg-white dark:bg-[#1c1c1e] rounded-2xl overflow-hidden transition-all duration-300 border border-gray-100 dark:border-white/5">
                            <img :src="img" class="w-full h-full object-cover">
                        </button>
                    </template>
                </div>
            </div>

            <!-- Right: Premium Content -->
            <div class="flex flex-col py-4">
                <nav class="mb-10 flex items-center space-x-3 text-[10px] font-bold uppercase tracking-[0.2em] text-gray-400">
                    <a href="/" class="hover:text-apple-blue transition-colors">Home</a>
                    <i class="fas fa-chevron-right text-[8px] opacity-30"></i>
                    <a href="/products" class="hover:text-apple-blue transition-colors">Catalog</a>
                    <i class="fas fa-chevron-right text-[8px] opacity-30"></i>
                    <span class="text-apple-blue bg-apple-blue/5 px-3 py-1 rounded-md" x-text="product?.category?.name || product?.category"></span>
                </nav>

                <h1 class="text-5xl md:text-6xl font-black text-apple-dark dark:text-white mb-10 tracking-tight leading-tight" x-text="product?.name"></h1>
                
                <div class="mb-12">
                    <span class="text-5xl font-black text-apple-blue" 
                          x-text="'₹' + product?.price.toLocaleString('en-IN')"></span>
                </div>

                <div class="space-y-12 mb-16">
                    <div>
                        <h3 class="text-[11px] font-bold tracking-[0.2em] uppercase text-gray-400 mb-8 flex items-center">
                            <i class="fas fa-microchip mr-2 text-apple-blue"></i>
                            Technical Specifications
                        </h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <template x-for="(value, key) in product?.specifications" :key="key">
                                <div class="px-6 py-5 bg-gray-50 dark:bg-white/5 rounded-2xl border border-transparent hover:border-apple-blue/10 transition-all group shadow-sm">
                                    <span class="block text-[9px] font-bold text-gray-400 uppercase tracking-widest mb-2 group-hover:text-apple-blue transition-colors" x-text="key"></span>
                                    <span class="text-apple-dark dark:text-white font-bold text-sm tracking-tight" x-text="value"></span>
                                </div>
                            </template>
                        </div>
                    </div>
                </div>

                <div class="mt-auto space-y-6">
                    <div class="flex flex-col sm:flex-row gap-4">
                        <button 
                            @click="window.open(`https://wa.me/919326203972?text=Hello! I am interested in the ${product.name} (₹${product.price.toLocaleString('en-IN')}) listed on Mamdani Computers. Here is the link: ${window.location.href}`, '_blank')"
                            class="flex-1 py-6 bg-apple-dark dark:bg-apple-blue text-white rounded-[1.5rem] font-bold text-lg hover:shadow-2xl hover:shadow-apple-blue/20 transition-all duration-500 flex items-center justify-center gap-3 active:scale-95">
                            <i class="fab fa-whatsapp text-xl"></i>
                            Inquire via WhatsApp
                        </button>
                        <button 
                            @click="if (navigator.share) { navigator.share({ title: product.name, url: window.location.href }) } else { navigator.clipboard.writeText(window.location.href); alert('Link copied to clipboard!') }"
                            class="px-8 py-6 bg-white dark:bg-white/5 text-apple-dark dark:text-white border border-gray-100 dark:border-white/10 rounded-[1.5rem] font-bold text-lg hover:bg-gray-50 dark:hover:bg-white/10 transition-all active:scale-95">
                            <i class="fas fa-share-alt"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
