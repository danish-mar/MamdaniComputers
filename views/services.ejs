<%
    const services = [
        {
            span: 'lg:col-span-7', icon: 'fa-tools',
            title: 'Core Repair Lab',
            body: 'Surgical-grade hardware diagnostics and component-level repairs for every major platform.',
            points: ['Screen & chassis replacement', 'Logic board micro-soldering', 'Thermal management overhaul'],
            image: 'https://images.unsplash.com/photo-1591405351990-4726e331f141?auto=format&fit=crop&q=80&w=900',
        },
        {
            span: 'lg:col-span-5', icon: 'fa-cogs',
            title: 'The Forge',
            body: 'Performance-driven custom workstations and gaming rigs, built to your exact digital fingerprint.',
            points: ['Bespoke part selection', 'Custom liquid-cooling loops', 'Cable-managed perfection'],
            cta: { href: '/contact', label: 'Start your build' },
        },
        {
            span: 'lg:col-span-5', icon: 'fa-hdd',
            title: 'Rescue Protocol',
            body: 'Advanced logical data recovery from failing drives, corrupted systems and accidental deletions.',
            points: ['Failed-drive imaging', 'Corrupted partition rebuilds', 'Secure data handling'],
        },
        {
            span: 'lg:col-span-7', icon: 'fa-tags',
            title: 'Curated Hardware',
            body: 'Every machine we sell undergoes a 50-point inspection. We call it The Mamdani Certification.',
            points: ['Certified pre-owned grading', 'Full diagnostic report', 'Warranty backed'],
            cta: { href: '/products', label: 'Browse the catalog' },
        },
    ];
%>

<!-- ===== HERO ===== -->
<section class="relative pt-36 pb-24 md:pt-44 md:pb-32 overflow-hidden">
    <div class="aurora"><span></span><span></span><span></span></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl reveal-on-scroll">
            <span class="inline-flex items-center gap-2 py-1.5 px-4 bg-black/5 dark:bg-white/10 text-apple-dark dark:text-white text-xs font-bold tracking-widest uppercase rounded-full mb-8">
                <span class="w-2 h-2 rounded-full bg-apple-dark dark:bg-white animate-pulse"></span> Expertise
            </span>
            <h1 class="text-5xl md:text-8xl font-black tracking-tighter text-apple-dark dark:text-white mb-8 leading-[0.95]">
                Service,<br><span class="animated-gradient-text">Mastered.</span>
            </h1>
            <p class="text-xl md:text-2xl text-gray-500 dark:text-gray-400 font-light leading-relaxed">
                From micro-soldering to enterprise deployments, our certified laboratory handles every pixel and byte with surgical precision.
            </p>
        </div>
    </div>
</section>

<!-- ===== SERVICES GRID ===== -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-28 md:mb-40">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <% services.forEach((s, i) => { %>
            <div class="reveal-on-scroll spotlight gradient-border <%= s.span %> rounded-[2rem] bg-white dark:bg-white/[0.03] p-10 md:p-12 group overflow-hidden" style="transition-delay: <%= i * 100 %>ms;">
                <div class="flex flex-col md:flex-row gap-10 h-full">
                    <div class="flex-1 flex flex-col">
                        <div class="w-16 h-16 rounded-2xl bg-apple-dark text-white dark:bg-white dark:text-apple-dark text-2xl flex items-center justify-center mb-8 shadow-lg shadow-black/10 transition-transform duration-500 group-hover:scale-110 group-hover:-rotate-6">
                            <i class="fas <%= s.icon %>"></i>
                        </div>
                        <h3 class="text-3xl font-bold text-apple-dark dark:text-white mb-4"><%= s.title %></h3>
                        <p class="text-gray-500 dark:text-gray-400 leading-relaxed text-lg mb-6"><%= s.body %></p>
                        <ul class="space-y-3 mt-auto">
                            <% s.points.forEach(point => { %>
                                <li class="flex items-center gap-3 text-sm font-medium text-apple-dark dark:text-gray-300">
                                    <i class="fas fa-check text-apple-dark dark:text-white"></i> <%= point %>
                                </li>
                            <% }) %>
                        </ul>
                        <% if (s.cta) { %>
                            <a href="<%= s.cta.href %>" class="mt-8 inline-flex items-center gap-2 font-bold text-apple-dark dark:text-white group/cta w-fit">
                                <%= s.cta.label %>
                                <i class="fas fa-arrow-right text-xs transition-transform group-hover/cta:translate-x-1"></i>
                            </a>
                        <% } %>
                    </div>
                    <% if (s.image) { %>
                        <div class="md:w-2/5 aspect-square md:aspect-auto rounded-[1.5rem] overflow-hidden shine grayscale">
                            <img src="<%= s.image %>" alt="<%= s.title %>" class="w-full h-full object-cover transition-transform duration-[1.2s] group-hover:scale-110">
                        </div>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>
</section>

<!-- ===== HOW WE WORK ===== -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-28 md:mb-40">
    <div class="text-center mb-16 reveal-on-scroll">
        <h2 class="text-4xl md:text-6xl font-bold text-apple-dark dark:text-white">No guesswork. <span class="gradient-text">Just results.</span></h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <% [
            { icon: 'fa-magnifying-glass-chart', title: 'Diagnose', body: 'A transparent, no-obligation assessment of exactly what’s wrong.' },
            { icon: 'fa-screwdriver-wrench',     title: 'Repair',   body: 'Component-level work using genuine, quality-graded parts.' },
            { icon: 'fa-circle-check',           title: 'Validate', body: 'Rigorous post-repair QC before it ever returns to you.' },
        ].forEach((step, i) => { %>
            <div class="reveal-on-scroll spotlight rounded-[2rem] bg-apple-gray dark:bg-white/[0.03] p-10" style="transition-delay: <%= i * 100 %>ms;">
                <div class="flex items-center gap-4 mb-6">
                    <span class="text-5xl font-black text-black/10 dark:text-white/10">0<%= i + 1 %></span>
                    <span class="w-12 h-12 rounded-xl bg-white dark:bg-white/10 shadow-sm flex items-center justify-center text-apple-dark dark:text-white text-xl">
                        <i class="fas <%= step.icon %>"></i>
                    </span>
                </div>
                <h3 class="text-2xl font-bold text-apple-dark dark:text-white mb-3"><%= step.title %></h3>
                <p class="text-gray-500 dark:text-gray-400 leading-relaxed"><%= step.body %></p>
            </div>
        <% }) %>
    </div>
</section>

<!-- ===== CTA ===== -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-28">
    <div class="reveal-on-scroll relative overflow-hidden rounded-[2.5rem] bg-apple-dark p-12 md:p-20 text-center">
        <div class="aurora opacity-60"><span></span><span></span><span></span></div>
        <div class="relative max-w-2xl mx-auto">
            <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">Don’t settle for “fixed.”<br>Aim for <span class="animated-gradient-text">perfect.</span></h2>
            <div class="flex flex-col sm:flex-row justify-center gap-4 mt-10">
                <a href="/contact" class="shine px-9 py-4 bg-white text-apple-dark rounded-full font-bold text-lg hover:bg-gray-100 transition-all hover:-translate-y-0.5">Book a diagnostic</a>
                <a href="/" class="px-9 py-4 bg-white/10 text-white rounded-full font-bold text-lg hover:bg-white/20 transition-all">Back to store</a>
            </div>
        </div>
    </div>
</section>
