<%
    // Single source of truth for nav links. `match` is compared against the
    // page `title` passed into res.render() to derive the active state.
    const navLinks = [
        { href: '/',         label: 'Home',     match: 'Home' },
        { href: '/products', label: 'Products', match: 'Products' },
        { href: '/repair',   label: 'Repair',   match: 'Repair Services' },
        { href: '/services', label: 'Services', match: 'Our Services' },
        { href: '/about',    label: 'About',    match: 'About Us' },
        { href: '/contact',  label: 'Contact',  match: 'Contact Us' },
    ];
%>

<header x-data="{ open: false }" class="glass sticky top-0 z-50 border-b border-gray-200/50 dark:border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16 gap-4">
            <!-- Logo -->
            <a href="/" class="flex items-center gap-2.5 group flex-shrink-0">
                <span class="w-9 h-9 flex items-center justify-center rounded-xl bg-apple-dark text-white dark:bg-white dark:text-apple-dark shadow-sm transition-transform group-hover:scale-105">
                    <i class="fas fa-laptop-code text-lg"></i>
                </span>
                <span class="font-bold text-lg tracking-tight text-apple-dark dark:text-white">Mamdani Computers</span>
            </a>

            <!-- Desktop nav (pill style) -->
            <nav class="hidden md:flex items-center gap-1 bg-gray-100/70 dark:bg-white/5 rounded-full p-1">
                <% navLinks.forEach(link => { const active = title === link.match; %>
                    <a href="<%= link.href %>"
                        class="px-4 py-2 text-sm font-medium rounded-full transition-all duration-300 <%= active
                            ? 'bg-white dark:bg-white/15 text-apple-dark dark:text-white shadow-sm'
                            : 'text-gray-600 dark:text-gray-400 hover:text-apple-dark dark:hover:text-white' %>"><%= link.label %></a>
                <% }) %>
            </nav>

            <!-- Right actions -->
            <div class="flex items-center gap-2 flex-shrink-0">
                <!-- Theme Toggle -->
                <div class="relative" x-data="{ menuOpen: false }">
                    <button @click="menuOpen = !menuOpen"
                        class="w-9 h-9 flex items-center justify-center rounded-full bg-gray-100/70 dark:bg-white/5 text-apple-dark dark:text-white transition-all hover:scale-105">
                        <i class="fas"
                            :class="$store.theme.mode === 'dark' ? 'fa-moon' : ($store.theme.mode === 'light' ? 'fa-sun' : 'fa-circle-half-stroke')"></i>
                    </button>
                    <div x-show="menuOpen" @click.away="menuOpen = false" x-cloak
                        x-transition:enter="transition ease-out duration-150"
                        x-transition:enter-start="opacity-0 scale-95 -translate-y-1"
                        x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                        class="absolute right-0 mt-2 w-32 glass border border-gray-200/50 dark:border-white/10 rounded-2xl shadow-2xl py-2 z-[60]">
                        <button @click="$store.theme.setMode('light'); menuOpen = false"
                            class="w-full px-4 py-2 text-left text-xs font-bold text-apple-dark dark:text-white hover:bg-black/5 dark:hover:bg-white/10 flex items-center">
                            <i class="fas fa-sun mr-3 w-4"></i> Light
                        </button>
                        <button @click="$store.theme.setMode('dark'); menuOpen = false"
                            class="w-full px-4 py-2 text-left text-xs font-bold text-apple-dark dark:text-white hover:bg-black/5 dark:hover:bg-white/10 flex items-center">
                            <i class="fas fa-moon mr-3 w-4"></i> Dark
                        </button>
                        <button @click="$store.theme.setMode('auto'); menuOpen = false"
                            class="w-full px-4 py-2 text-left text-xs font-bold text-apple-dark dark:text-white hover:bg-black/5 dark:hover:bg-white/10 flex items-center">
                            <i class="fas fa-circle-half-stroke mr-3 w-4"></i> Auto
                        </button>
                    </div>
                </div>

                <!-- Mobile menu button -->
                <button @click="open = !open"
                    class="md:hidden w-9 h-9 flex items-center justify-center rounded-full bg-gray-100/70 dark:bg-white/5 text-apple-dark dark:text-white transition-all hover:scale-105 focus:outline-none">
                    <i class="fas" :class="open ? 'fa-times' : 'fa-bars'"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Menu Overlay -->
    <template x-teleport="body">
        <div x-show="open" @click="open = false" x-transition:enter="transition opacity-100 duration-300"
            x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
            class="fixed inset-0 z-[49] bg-white/20 backdrop-blur-2xl md:hidden"></div>
    </template>

    <!-- Mobile Menu Panel -->
    <div x-show="open" x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-4" x-transition:enter-end="opacity-100 translate-y-0"
        class="md:hidden glass border-b border-gray-200/50 dark:border-white/10 shadow-xl relative z-50">
        <div class="px-4 pt-2 pb-6 space-y-1 sm:px-3">
            <% navLinks.forEach(link => { const active = title === link.match; %>
                <a href="<%= link.href %>"
                    class="block py-3 px-4 text-base font-medium rounded-xl transition-colors <%= active
                        ? 'bg-black/5 dark:bg-white/10 text-apple-dark dark:text-white'
                        : 'text-gray-700 dark:text-gray-300 hover:bg-gray-50/50 dark:hover:bg-white/5 hover:text-apple-dark dark:hover:text-white' %>"><%= link.label %></a>
            <% }) %>

            <div class="pt-6 mt-6 border-t border-gray-100 dark:border-white/10">
                <span class="text-[10px] uppercase font-bold text-gray-400 tracking-widest px-4 mb-4 block">Theme Settings</span>
                <div class="grid grid-cols-3 gap-3 px-2">
                    <button @click="$store.theme.setMode('light')"
                        :class="$store.theme.mode === 'light' ? 'bg-apple-dark text-white dark:bg-white dark:text-apple-dark' : 'bg-apple-gray dark:bg-white/5 text-gray-600'"
                        class="py-3 rounded-xl flex flex-col items-center justify-center transition-all">
                        <i class="fas fa-sun mb-2"></i>
                        <span class="text-[10px] font-bold">Light</span>
                    </button>
                    <button @click="$store.theme.setMode('dark')"
                        :class="$store.theme.mode === 'dark' ? 'bg-apple-dark text-white dark:bg-white dark:text-apple-dark' : 'bg-apple-gray dark:bg-white/5 text-gray-600'"
                        class="py-3 rounded-xl flex flex-col items-center justify-center transition-all">
                        <i class="fas fa-moon mb-2"></i>
                        <span class="text-[10px] font-bold">Dark</span>
                    </button>
                    <button @click="$store.theme.setMode('auto')"
                        :class="$store.theme.mode === 'auto' ? 'bg-apple-dark text-white dark:bg-white dark:text-apple-dark' : 'bg-apple-gray dark:bg-white/5 text-gray-600'"
                        class="py-3 rounded-xl flex flex-col items-center justify-center transition-all">
                        <i class="fas fa-circle-half-stroke mb-2"></i>
                        <span class="text-[10px] font-bold">Auto</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</header>
