<%
    const footerExpertise = [
        { href: '/repair',   label: 'Repair Lab' },
        { href: '/services', label: 'Custom Workstations' },
        { href: '/products', label: 'Certified Hardware' },
        { href: '/services', label: 'Data Recovery' },
    ];
    const footerExplore = [
        { href: '/',        label: 'Home' },
        { href: '/products',label: 'Products' },
        { href: '/about',   label: 'About' },
        { href: '/contact', label: 'Contact' },
    ];
%>

<footer class="relative bg-[#0a0a0c] text-white overflow-hidden">
    <!-- Aurora glow + gradient hairline -->
    <div class="aurora opacity-70"><span></span><span></span><span></span></div>
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-white/40 to-transparent"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8">
            <!-- Brand -->
            <div class="lg:col-span-4 space-y-6">
                <a href="/" class="flex items-center gap-2.5 group w-fit">
                    <span class="w-9 h-9 flex items-center justify-center rounded-xl bg-white text-apple-dark shadow-lg shadow-black/30 transition-transform group-hover:scale-105">
                        <i class="fas fa-laptop-code"></i>
                    </span>
                    <span class="font-bold text-lg tracking-tight">Mamdani Computers</span>
                </a>
                <p class="text-white/50 text-sm leading-relaxed max-w-xs">
                    Crafting premium computing experiences through expert sales and meticulous, component-level repairs.
                </p>
                <div class="flex items-center gap-3">
                    <a href="#" aria-label="Facebook" class="w-10 h-10 rounded-full bg-white/5 hover:bg-white flex items-center justify-center text-white/70 hover:text-apple-dark transition-all duration-300 hover:-translate-y-1">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="#" aria-label="Instagram" class="w-10 h-10 rounded-full bg-white/5 hover:bg-white flex items-center justify-center text-white/70 hover:text-apple-dark transition-all duration-300 hover:-translate-y-1">
                        <i class="fab fa-instagram"></i>
                    </a>
                    <a href="#" aria-label="Twitter" class="w-10 h-10 rounded-full bg-white/5 hover:bg-white flex items-center justify-center text-white/70 hover:text-apple-dark transition-all duration-300 hover:-translate-y-1">
                        <i class="fab fa-twitter"></i>
                    </a>
                </div>
            </div>

            <!-- Expertise -->
            <div class="lg:col-span-2">
                <h3 class="text-xs font-semibold text-white/40 tracking-widest uppercase mb-5">Expertise</h3>
                <ul class="space-y-3">
                    <% footerExpertise.forEach(item => { %>
                        <li>
                            <a href="<%= item.href %>" class="group inline-flex items-center text-sm text-white/55 hover:text-white transition-colors">
                                <span class="transition-transform duration-300 group-hover:translate-x-1"><%= item.label %></span>
                            </a>
                        </li>
                    <% }) %>
                </ul>
            </div>

            <!-- Explore -->
            <div class="lg:col-span-2">
                <h3 class="text-xs font-semibold text-white/40 tracking-widest uppercase mb-5">Explore</h3>
                <ul class="space-y-3">
                    <% footerExplore.forEach(item => { %>
                        <li>
                            <a href="<%= item.href %>" class="group inline-flex items-center text-sm text-white/55 hover:text-white transition-colors">
                                <span class="transition-transform duration-300 group-hover:translate-x-1"><%= item.label %></span>
                            </a>
                        </li>
                    <% }) %>
                </ul>
            </div>

            <!-- Visit -->
            <div class="lg:col-span-4">
                <h3 class="text-xs font-semibold text-white/40 tracking-widest uppercase mb-5">Visit Us</h3>
                <p class="text-sm text-white/55 leading-relaxed">
                    Shop No. 6, OK Tower, Paithan Gate,<br>
                    beside Ambedkar Statue,<br>
                    Chhatrapati Sambhajinagar, 431001
                </p>
                <a href="tel:09326203972" class="mt-4 inline-flex items-center gap-2 text-sm text-white/70 hover:text-white transition-colors">
                    <i class="fas fa-phone text-white/50 text-xs"></i> 093262 03972
                </a>
                <span class="mt-4 flex items-center gap-2 w-fit px-3 py-1.5 rounded-full bg-white/5 text-xs text-white/60">
                    <span class="w-2 h-2 rounded-full bg-white/50 animate-pulse"></span> Closed · Opens 10:30 am Sat
                </span>
            </div>
        </div>

        <!-- Bottom bar -->
        <div class="mt-16 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-xs text-white/40">&copy; 2026 Mamdani Computers. Precision in every pixel.</p>
            <button onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
                class="group inline-flex items-center gap-2 text-xs text-white/50 hover:text-white transition-colors">
                Back to top
                <span class="w-7 h-7 rounded-full bg-white/5 group-hover:bg-white group-hover:text-apple-dark flex items-center justify-center transition-all group-hover:-translate-y-1">
                    <i class="fas fa-arrow-up text-[10px]"></i>
                </span>
            </button>
        </div>
    </div>
</footer>
